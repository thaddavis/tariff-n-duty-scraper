# Database the cmdlabs API uses, migrated to c7a1d2e3f4b5 or later
POSTGRES_URL=postgresql://user:password@host:5432/postgres
# The organization whose tariff updates this job maintains
TND_ORG_ID=
OPENAI_API_KEY=
# Optional
# gpt-5.4 (default) or gpt-4o
TND_MODEL=gpt-5.4
TND_LOOKBACK_DAYS=14
TND_MAX_DOCS=25
# Tariff codes the customer imports; their base rates are loaded from the USITC
TND_HTS_CODES=8703.23.01,8541.43.00
